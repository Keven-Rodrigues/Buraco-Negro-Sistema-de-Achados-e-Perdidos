<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppUsuario.Views.DetalhesItemPage"
             Title="Detalhes do objeto">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="6">

            <Label
                Text="{Binding Nome}"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,20,0,20"/>

            <Label
                Text="Descrição"
                FontAttributes="Bold"/>

            <Label
                Text="{Binding Descricao}"
                Margin="0,0,0,10"/>

            <Label
                Text="Categoria"
                FontAttributes="Bold"/>

            <Label
                Text="{Binding Categoria}"
                Margin="0,0,0,10"/>

            <Label
                Text="Local onde foi perdido ou encontrado"
                FontAttributes="Bold"/>

            <Label
                Text="{Binding Local}"
                Margin="0,0,0,10"/>

            <Label
                Text="Status"
                FontAttributes="Bold"/>

            <Label
                Text="{Binding Status}"
                Margin="0,0,0,10"/>

            <Label
                Text="Data do registro"
                FontAttributes="Bold"/>

            <Label
                Text="{Binding DataRegistro, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                Margin="0,0,0,10"/>

            <Button
                x:Name="btnSelecionar"
                Text="Tenho interesse neste objeto"
                Clicked="btnSelecionar_Clicked"
                Margin="0,20,0,0"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>