<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppUsuario.Views.CadastroItemPage"
             Title="{Binding TituloTela}">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="10">

            <Label
                Text="{Binding TituloTela}"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,20,0,20"/>

            <Label Text="Nome do objeto"/>

            <Entry
                Placeholder="Ex.: Carteira preta"
                Text="{Binding Nome}"/>

            <Label Text="Descrição"/>

            <Editor
                Placeholder="Descreva o objeto"
                Text="{Binding Descricao}"
                HeightRequest="100"
                TextColor="{StaticResource Black}"
                BackgroundColor="{StaticResource InputBackground}"/>

            <Label Text="Categoria"/>

            <Entry
                Placeholder="Ex.: Documentos, Eletrônicos, Roupas"
                Text="{Binding Categoria}"/>

            <Label Text="Local onde foi perdido ou encontrado"/>

            <Entry
                Placeholder="Ex.: Biblioteca"
                Text="{Binding Local}"/>

            <Label Text="Status"/>

            <Picker
                Title="Escolha o status"
                ItemsSource="{Binding StatusOpcoes}"
                SelectedItem="{Binding Status}"
                TextColor="{StaticResource Black}"
                BackgroundColor="{StaticResource InputBackground}"
                HeightRequest="45"/>

            <Button
                Text="Salvar"
                Clicked="btnSalvar_Clicked"
                Margin="0,20,0,0"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>