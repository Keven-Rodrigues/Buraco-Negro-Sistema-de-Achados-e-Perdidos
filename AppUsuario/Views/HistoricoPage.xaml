<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppUsuario.Views.HistoricoPage"
             x:Name="paginaHistorico"
             Title="{Binding TituloTela}">

    <Grid
        Padding="20"
        RowSpacing="10"
        RowDefinitions="Auto,*">

        <Label
            Grid.Row="0"
            Text="{Binding TituloTela}"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Margin="0,10,0,10"/>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Registros}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label
                    Text="Nenhuma seleção registrada ainda."
                    HorizontalOptions="Center"
                    Margin="0,30,0,0"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Stroke="{StaticResource Gray400}"
                        StrokeShape="RoundRectangle 8"
                        Padding="12">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="{Binding ItemNome}"
                                FontSize="18"
                                FontAttributes="Bold"/>

                            <!-- Só o administrador vê o nome do usuário -->
                            <Label
                                Text="{Binding UsuarioNome, StringFormat='Usuário: {0}'}"
                                IsVisible="{Binding BindingContext.MostrarUsuario, Source={x:Reference paginaHistorico}}"/>

                            <Label
                                Text="{Binding DataHora, StringFormat='Selecionado em {0:dd/MM/yyyy HH:mm}'}"
                                FontSize="12"
                                TextColor="{StaticResource Gray500}"/>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>