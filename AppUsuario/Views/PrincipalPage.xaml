<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppUsuario.Views.PrincipalPage"
             Title="Principal">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="10">

            <Label
                Text="Dados do Usuário"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,20,0,25"/>

            <Label
                Text="Nome"
                FontAttributes="Bold"/>

            <Entry
                Text="{Binding Nome}"
                IsReadOnly="True"/>

            <Label
                Text="CPF"
                FontAttributes="Bold"/>

            <Entry
                Text="{Binding Cpf}"
                IsReadOnly="True"/>

            <Label
                Text="E-mail"
                FontAttributes="Bold"/>

            <Entry
                Text="{Binding Email}"
                IsReadOnly="True"/>

            <Label
                Text="Data de nascimento"
                FontAttributes="Bold"/>

            <Entry
                Text="{Binding DataNascimento, StringFormat='{0:dd/MM/yyyy}'}"
                IsReadOnly="True"/>

            <Button
                Text="Atualizar"
                Clicked="btnAtualizar_Clicked"
                Margin="0,20,0,0"/>

            <Button
                Text="Visualizar"
                BackgroundColor="#EEEEEE"
                TextColor="#1976D2"
                Clicked="btnVisualizar_Clicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>